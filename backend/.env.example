# ==============================================================================
# PulseRoute Backend Environment Configuration (Template)
# Copy this file to .env and adjust variables to match your environment.
# DO NOT commit real secrets or passwords to source control.
# ==============================================================================

# Application Settings
PROJECT_NAME="PulseRoute Emergency Response API"
API_V1_STR="/api/v1"
DEBUG=true

# Database Settings
# Primary: PostgreSQL (e.g. postgresql://<user>:<password>@<host>:<port>/<dbname>)
# Fallback: SQLite is supported for fast testing when PostgreSQL is not running (e.g. sqlite:///./pulseroute.db)
DATABASE_URL=postgresql://USER:REPLACE_WITH_PASSWORD@HOST:5432/DATABASE_NAME

# CORS Origins (comma-separated list of allowed origins)
# Allows the React + Vite frontend running locally
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo & Simulation Flags
DEMO_MODE=true
IS_REAL_EMERGENCY_SERVICE=false

# Milestone 9.1: WebSocket & JWT Security Settings
# Generate a strong 256-bit secret key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
WS_ALLOWED_ROLES=ADMIN,DISPATCHER,OPERATOR,DRIVER,HOSPITAL

