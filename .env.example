# ==============================================================================
# PulseRoute Emergency Response Dispatch System - Environment Configuration
# Milestone 10.1: Production Security Hardening & Safe Configuration Template
# ==============================================================================
# Copy this file to '.env' for local configuration.
# NEVER commit the active '.env' file containing secrets or credentials to Git!

# ------------------------------------------------------------------------------
# 1. Environment & Debugging
# ------------------------------------------------------------------------------
# Options: 'development', 'staging', 'production'
ENVIRONMENT=production

# Must be 'False' in production. Set to 'True' ONLY during local development.
DEBUG=False

# Academic prototype / demo mode.
# When False (Production):
#  - GET /api/v1/auth/demo-token is disabled (returns HTTP 403)
#  - POST /api/v1/auth/token requires valid user password credentials
DEMO_MODE=False

# Safety disclaimer: PulseRoute is a prototype and not connected to real 108/112 EMS.
IS_REAL_EMERGENCY_SERVICE=False

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Production: Managed PostgreSQL connection string (e.g. AWS RDS, Railway, Neon)
DATABASE_URL=postgresql://postgres:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/pulseroute

# Fallback SQLite DB when PostgreSQL is not reachable in local dev
SQLITE_FALLBACK_URL=sqlite:///./pulseroute.db

# ------------------------------------------------------------------------------
# 3. JWT & Session Security
# ------------------------------------------------------------------------------
# CRITICAL: In production, generate a secure random 64-character hex key!
# Example: python -c "import secrets; print(secrets.token_hex(32))"
# The backend will FAIL TO START in production if this uses the development default!
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS

# JWT Signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (Short-lived: 15 minutes recommended for security)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token rotation lifetime in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. Browser Cookies & CSRF Protection
# ------------------------------------------------------------------------------
# Set to True in production so cookies are transmitted ONLY over HTTPS
COOKIE_SECURE=True

# SameSite cookie policy ('lax' or 'strict')
COOKIE_SAMESITE=lax

# Double-Submit Cookie CSRF protection for browser state-changing requests
CSRF_PROTECTION_ENABLED=True

# ------------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed origins. Do NOT use wildcards in production!
CORS_ORIGINS=https://pulseroute.app,https://admin.pulseroute.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True

# Maximum SOS emergency creation requests per minute per IP
RATE_LIMIT_SOS_PER_MINUTE=5

# Maximum login/token authentication attempts per minute per IP
RATE_LIMIT_AUTH_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 7. WebSocket Live Telemetry Permissions
# ------------------------------------------------------------------------------
# Comma-separated list of roles authorized to establish WebSocket connections to /ws/live
WS_ALLOWED_ROLES=ADMIN,DISPATCHER,OPERATOR,DRIVER,HOSPITAL

